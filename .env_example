// .env_example
LLM_PROVIDER="openai_compatible" # Choose your LLM provider: "gemini", "openai", or "openai_compatible"

# --- OpenAI-Compatible Local LLM Configuration (e.g., Ollama, LiteLLM, vLLM) ---
# Ensure your local LLM server (like Ollama) is running and the model is downloaded/available.
# Set LLM_PROVIDER="openai_compatible" above to use this section.
OPENAI_COMPATIBLE_ENDPOINT_URL="http://localhost:11434/v1" # Example for Ollama
OPENAI_COMPATIBLE_MODEL_NAME="llama3" # Model name as served by your local endpoint (e.g., "llama3", "codellama:7b-instruct", "qwen2:7b-instruct")
OPENAI_COMPATIBLE_API_KEY="ollama" # Often "ollama", "not-needed", or any string if your endpoint doesn't require an API key.
OPENAI_COMPATIBLE_NUM_CTX=40960  # Optional: Context window size (e.g., Ollama's num_ctx). Leave blank or remove if not supported/needed.

# --- OpenAI API Configuration ---
# Set LLM_PROVIDER="openai" to use this section.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY" # Your actual OpenAI API key (e.g., sk-...)
OPENAI_MODEL_NAME="gpt-4o" # Or "gpt-3.5-turbo", "gpt-4-turbo", etc.

# --- Google Gemini API Configuration ---
# Set LLM_PROVIDER="gemini" to use this section.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY" # Your actual Gemini API key
GEMINI_MODEL_NAME="gemini-1.5-flash-latest" # Or "gemini-1.5-pro-latest", etc.

# --- Fallback/Alternative Model Configurations (Less commonly changed) ---
# These are loaded by config/settings.py but primarily for alternative choices, not the main generation path.
# The CodeGeneratorAgent uses the primary GEMINI_MODEL_NAME or OPENAI_MODEL_NAME based on LLM_PROVIDER.

# Example for Gemini specific models (if you had FLASH/PRO tiers named differently)
# GEMINI_MODEL_NAME_PRO_FALLBACK="gemini-1.5-pro-latest"
# GEMINI_MODEL_NAME_FLASH_FALLBACK="gemini-1.5-flash-latest"

# Example for evaluation model (if using a different model for evaluation tasks, not currently central to CodeGeneratorAgent)
# EVALUATION_API_KEY="YOUR_API_KEY_FOR_EVALUATION_MODEL_IF_DIFFERENT"
# EVALUATION_BASE_URL="https://api.openai.com/v1" # Or your Gemini endpoint
# EVALUATION_MODEL="gpt-4o" # Or a Gemini model